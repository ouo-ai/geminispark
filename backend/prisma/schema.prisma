generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TaskStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

enum TaskIntent {
  TEXT
  IMAGE
  TEXT_TO_VIDEO
  IMAGE_TO_VIDEO
}

enum ArtifactKind {
  TEXT
  IMAGE
  VIDEO
  OTHER
}

enum BillingPlan {
  FREE
  STARTUP
  PRO
}

enum BillingInterval {
  MONTH
  YEAR
}

enum SubscriptionStatus {
  NONE
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
}

enum CreditBucket {
  FREE
  PERIOD
}

enum CreditTransactionType {
  GRANT
  DEBIT
  REFUND
}

enum WorkspaceStatus {
  PENDING
  READY
  FAILED
}

model Task {
  id             String       @id @default(cuid())
  clientTaskId   String?
  externalUserId String?
  sessionId      String?
  projectAgentId String?
  chatThreadId   String?
  message        String
  intent         TaskIntent
  status         TaskStatus   @default(QUEUED)
  progress       Int          @default(0)
  provider       String?
  model          String?
  creditCost     Int          @default(0)
  creditBucket   CreditBucket?
  workspaceId    String?
  runtimeRunId   String?
  runtimeSessionId String?
  lastRuntimeEventAt DateTime?
  input          Json
  result         Json?
  error          String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  events         TaskEvent[]
  artifacts      Artifact[]
  projectAgent   ProjectAgent? @relation(fields: [projectAgentId], references: [id], onDelete: SetNull)
  chatThread     ChatThread?   @relation(fields: [chatThreadId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([externalUserId, createdAt])
  @@index([sessionId, createdAt])
  @@index([projectAgentId, createdAt])
  @@index([chatThreadId, createdAt])
  @@index([clientTaskId])
  @@index([workspaceId])
  @@index([runtimeRunId])
  @@index([status, lastRuntimeEventAt])
}

model TaskEvent {
  id        String   @id @default(cuid())
  taskId    String
  type      String
  message   String
  data      Json?
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model Artifact {
  id        String       @id @default(cuid())
  taskId    String
  kind      ArtifactKind
  url       String?
  text      String?
  metadata  Json?
  createdAt DateTime     @default(now())
  task      Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  credit        UserCredit?
  profile       UserProfile?
  creditTransactions CreditTransaction[]
  workspaces    UserWorkspace[]
  projectAgents ProjectAgent[]
  chatThreads   ChatThread[]

  @@unique([email])
  @@map("user")
}

model UserProfile {
  userId        String   @id
  nickname      String?
  language      String   @default("zh-CN")
  preferences   Json?
  memorySummary String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProjectAgent {
  id             String          @id @default(cuid())
  userId         String
  name           String
  description    String?
  status         WorkspaceStatus @default(PENDING)
  workspaceId    String?
  runtimeAgentId String?
  memorySummary  String?
  instructions   String?
  archivedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatThreads    ChatThread[]
  tasks          Task[]

  @@index([userId, archivedAt, updatedAt])
  @@index([workspaceId])
}

model ChatThread {
  id             String       @id @default(cuid())
  userId         String
  projectAgentId String
  title          String
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectAgent   ProjectAgent @relation(fields: [projectAgentId], references: [id], onDelete: Cascade)
  tasks          Task[]

  @@index([userId, projectAgentId, updatedAt])
  @@index([projectAgentId, archivedAt, updatedAt])
}

model UserCredit {
  userId                 String             @id
  freeCreditsRemaining   Int                @default(2)
  periodCreditsRemaining Int                @default(0)
  plan                   BillingPlan        @default(FREE)
  billingInterval        BillingInterval?
  subscriptionStatus     SubscriptionStatus @default(NONE)
  stripeCustomerId       String?            @unique
  stripeSubscriptionId   String?            @unique
  creditsPeriodStart     DateTime?
  creditsPeriodEnd       DateTime?
  nextCreditGrantAt      DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreditTransaction {
  id                 String                @id @default(cuid())
  userId             String
  taskId             String?
  type               CreditTransactionType
  bucket             CreditBucket?
  amount             Int
  balanceAfterFree   Int
  balanceAfterPeriod Int
  description        String?
  stripeEventId      String?
  idempotencyKey     String?               @unique
  metadata           Json?
  createdAt          DateTime              @default(now())
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([taskId])
  @@index([stripeEventId])
}

model UserWorkspace {
  id            String          @id @default(cuid())
  userId        String
  provider      String          @default("openclaw")
  workspaceId   String
  runtimeSessionId String?
  runtimeAgentId String?
  status        WorkspaceStatus @default(PENDING)
  initializedAt DateTime?
  lastUsedAt    DateTime?
  lastSyncedAt  DateTime?
  error         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@unique([provider, workspaceId])
  @@index([status, updatedAt])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
